{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "${SEQ_URL}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "Properties": {
            "Application": "api"
        }
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "AllowedHosts": "*",

    "ConnectionStrings": {
        "Default": "${DB_CONNECTION_STRING}"
    },

    "JwtSettings": {
        "SecretKey": "${JWT_SECRET_KEY}",
        "Issuer": "MetaBlog",
        "Audience": "MetaBlogClient",
        "DurationInMinutes": 60,
        "RefreshTokenExpiryDays": 15
    },

    "ClientSetting": {
        "ClientDomain": "http://localhost:4200"
    },

    "EmailSettings": {
        "FromEmail": "${EMAIL_FROM}",
        "SmtpServer": "${SMTP_SERVER}",
        "SmtpPort": "${SMTP_PORT}",
        "SmtpUser": "${SMTP_USER}",
        "SmtpPass": "${SMTP_PASS}"
    }
}
